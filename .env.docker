# =============================================================================
# Schema Genius — Docker Environment File
#
# This file is safe to commit (no real secrets — only placeholders).
# It is loaded by the `app` and `reverb` services via `env_file` in
# docker-compose.yml.
#
# FIRST-TIME SETUP:
#   1. Replace every "change_me_*" value with a real secret.
#   2. Run `make dev` then `make key` — copy the printed APP_KEY here.
#   3. Run `make migrate` to create the database tables.
#
# Keys to generate:
#   APP_KEY            → make key  (or: docker compose exec app php artisan key:generate --show)
#   REVERB_APP_KEY     → openssl rand -hex 20
#   REVERB_APP_SECRET  → openssl rand -hex 20
#   REVERB_APP_ID      → any unique string, e.g. schema-genius-local
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Schema-Genius
APP_ENV=local
# Generate with: make key
APP_KEY=base64:X/GpRnUiTIfJzUfL2Vi28QEL34YRW6LwMZmyAklIH/E=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# DB_HOST MUST be the Docker service name — not 127.0.0.1 or localhost.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=schema_genius
DB_USERNAME=schema_user
DB_PASSWORD=schema_password

# ── Auth / Laravel Sanctum ────────────────────────────────────────────────────
# Comma-separated list of frontend origins that receive session cookies.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost
SANCTUM_TOKEN_EXPIRATION=43200

# CORS is driven by FRONTEND_URL (see backend/config/cors.php).
# In development the React Vite dev server runs on port 5173.
FRONTEND_URL=http://localhost:5173

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# ── Cache / Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=database

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Broadcasting — Laravel Reverb ─────────────────────────────────────────────
# BROADCAST_CONNECTION must be "reverb" (not "log") to enable WebSocket events.
BROADCAST_CONNECTION=reverb

# REVERB_HOST is the hostname the `app` container uses to SEND events.
# Inside Docker the service is reachable by its service name "reverb".
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# REVERB_SERVER_HOST is what the Reverb process BINDS to.
# Must be 0.0.0.0 so it accepts connections from other containers.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Reverb application credentials — must match on both server and client.
# Generate: openssl rand -hex 20
REVERB_APP_ID=1
REVERB_APP_KEY=sg-local-key
REVERB_APP_SECRET=sg-local-secret

# ── Mail ──────────────────────────────────────────────────────────────────────
# "log" driver writes emails to storage/logs — useful for development.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=hamzafartota@gmail.com
MAIL_PASSWORD="kldl wpvn fvle svns"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hamzafartota@gmail.com
MAIL_FROM_NAME="Schema Genius"

# ── AI Integration ────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=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

# ── Vite (informational — not read by backend) ────────────────────────────────
# These are set directly in the `frontend` service environment in compose.
# Documented here for reference only.
# VITE_API_URL=http://localhost:8000        ← no /api suffix (api.js adds it)
# VITE_REVERB_APP_KEY=sg-local-key
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
