APP_NAME=Schema-Genius
# SECURITY: In production set APP_ENV=production and APP_DEBUG=false.
# APP_DEBUG=true leaks full stack traces, .env values, and credentials in HTTP error responses.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
# SECURITY: In production use LOG_LEVEL=warning or LOG_LEVEL=error.
# debug level logs sensitive request data.
LOG_LEVEL=debug

# Database — MySQL (XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schema_genius
DB_USERNAME=root
DB_PASSWORD=

# Sanctum — allow requests from React dev server
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# SANCTUM_TOKEN_EXPIRATION: minutes until tokens expire (default 43200 = 30 days).
# Set to null to disable expiry (NOT recommended for production).
SANCTUM_TOKEN_EXPIRATION=43200
FRONTEND_URL=http://localhost:5173

# CORS — set to your production domain(s), comma-separated.
# Falls back to FRONTEND_URL if not set.
# CORS_ALLOWED_ORIGINS=https://schema-genius.com,https://www.schema-genius.com

SESSION_DRIVER=file
SESSION_LIFETIME=120
# SECURITY: Enable session encryption in production.
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@schema-genius.com"
MAIL_FROM_NAME="${APP_NAME}"

# AI Integration (add your key here when ready)
GROQ_API_KEY=

VITE_APP_NAME="${APP_NAME}"