# =============================================================================
# Schema Genius — Docker Environment EXAMPLE
#
# SETUP:
#   cp .env.docker.example .env.docker
#   # then fill in every value marked  ← fill this in
#
# WARNING: NEVER commit .env.docker — it is listed in .gitignore.
#          Only this .env.docker.example file (with placeholders) is committed.
# =============================================================================

# ── Production server URL ─────────────────────────────────────────────────────
# Set this to your server's full public URL when deploying to a real server.
# Used for: email verification links, password-reset links, APP_URL, FRONTEND_URL.
# Format: scheme + host, NO trailing slash, NO /api suffix.
#
# ⚠ WARNING — write http:// only ONCE. A common mistake is:
#   BAD:  SERVER_URL=http:http://34.163.220.141   ← breaks email links
#   GOOD: SERVER_URL=http://34.163.220.141
#
# Leave as http://localhost for local Docker development.
SERVER_URL=http://localhost

# Public hostname for WebSocket connections (NO http:// prefix, just the host).
# The browser opens a WebSocket to this host — relative URLs are not possible.
# Leave as localhost for local development.
# e.g.  34.163.220.141   or   schema-genius.com
REVERB_PUBLIC_HOST=localhost

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Schema-Genius
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000

# Generate with: docker compose exec app php artisan key:generate --show
APP_KEY=                                          # ← fill this in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# DB_HOST must be the Docker service name, not 127.0.0.1 or localhost
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=schema_genius
DB_USERNAME=schema_user
DB_PASSWORD=schema_password

# ── Auth / Sanctum ────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost
SANCTUM_TOKEN_EXPIRATION=43200
FRONTEND_URL=http://localhost:5173

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# ── Cache / Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=database

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Broadcasting — Laravel Reverb ─────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

REVERB_APP_ID=1
REVERB_APP_KEY=your-reverb-app-key-here          # ← fill this in
REVERB_APP_SECRET=your-reverb-app-secret-here    # ← fill this in

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com                     # ← fill this in
MAIL_PASSWORD=your-gmail-app-password-here       # ← fill this in
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your@gmail.com                 # ← fill this in
MAIL_FROM_NAME="Schema Genius"

# ── AI Integration — Groq ────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here              # ← fill this in
